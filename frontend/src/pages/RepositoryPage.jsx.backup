          </VStack>
        </GridItem>
        
        {/* Main content area */}
        <GridItem colSpan={{ base: 12, md: 9 }} height="calc(100vh - 180px)" overflowY="auto">
          {selectedFile ? (
            <Box>
              <Flex justifyContent="space-between" alignItems="center" mb={2}>
                <HStack spacing={2}>
