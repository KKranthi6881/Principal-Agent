<SyntaxHighlighter
language={getFileExtension(selectedFile?.name || '')}
style={docco}
showLineNumbers
customStyle={{ 
backgroundColor: 'transparent',
fontSize: '0.9em',
        {/* Repository selector */}
        <GridItem colSpan={12} mb={4}>
