              />
            </InputGroup>
            
            {loading && !fileTree.length ? (
              <Box textAlign="center" py={8}>
                <Spinner />
              </Box>
            ) : (
              <>
                {renderFileTree(fileTree)}
                {fileTree.length === 0 && !loading && (
                  <Box textAlign="center" py={8}>
                    <Text color="gray.500">No files found</Text>
                  </Box>
