    def _extract_yaml_dependencies(self, content, file_path):
        """Extract dependencies from a DBT YAML/YML file.
        
        Args:
            content: A string with the file content.
            file_path: The path to the file.
            
        Returns:
            A dictionary with extracted dependencies and model metadata.
        """
        result = {
            "model_name": None,
            "refs": [],
            "sources": [],
            "tables": [],
            "errors": [],
            "columns": [],  # Add columns list to store column information
            "models_metadata": {}  # Add model metadata dictionary
        }
    
        try:
            # Parse the YAML content
            yaml_data = yaml.safe_load(content)
            if not yaml_data:
                result["errors"].append("Empty or invalid YAML file")
                return result
                
