    def store_lineage(self, table_id: str, lineage_data: dict, github_path: str = None) -> str:
        """
        Store lineage information for a table in the database
        
        Args:
            table_id: ID of the table
            lineage_data: Dictionary with lineage information
            github_path: Path to the file in GitHub
            
        Returns:
            Lineage definition ID
        """
        logger.info(f"Storing lineage for table {table_id} with {len(lineage_data)} items")
        
        # Process table lineage
        table_lineage = lineage_data.get("table_lineage", {})
        column_lineage = lineage_data.get("column_lineage", {})
        
        # Get source tables from table lineage
        source_tables = []
        if "source_tables" in table_lineage:
            for source in table_lineage["source_tables"]:
                if isinstance(source, dict):
                    source_tables.append(source.get("name"))
                elif isinstance(source, str):
                    source_tables.append(source)
        
        conn = self._get_connection()
        cursor = conn.cursor()
        
        try:
            # Create relationships between tables
            for source_table_name in source_tables:
                if source_table_name:
                    try:
                        # Find or create source table
                        source_table = self.get_table_by_name(source_table_name)
                        if not source_table:
                            # Create source table
                            source_id = self.create_or_get_table(
                                table_name=source_table_name,
                                tech_stack="unknown",  # Using unknown since we dont have tech stack info
                                github_path=github_path
                            )
                        else:
                            source_id = source_table["table_id"]
                        
                        # Create relationship
                        if source_id:
                            self.create_or_get_relationship(
                                source_table_id=source_id,
                                target_table_id=table_id,
                                relationship_type="dependency",
                                github_path=github_path
                            )
                            logger.debug(f"Created table relationship: {source_table_name} -> {table_id}")
                    except Exception as e:
                        logger.warning(f"Error creating table relationship: {str(e)}")
            
            # Process column lineage data
            # First process target columns
            if "target_columns" in column_lineage:
                for column in column_lineage["target_columns"]:
                    try:
                        if isinstance(column, dict):
                            column_name = column.get("name") or column.get("column_name")
                            data_type = column.get("data_type", "unknown")
                            description = column.get("description", "")
                            is_primary = column.get("is_primary_key", False)
                            is_foreign = column.get("is_foreign_key", False)
                        elif isinstance(column, str):
                            column_name = column
                            data_type = "unknown"
                            description = ""
                            is_primary = False
                            is_foreign = False
                        
                        if column_name:
                            # Create or get column
                            column_id = self.create_or_get_column(
                                table_id=table_id,
                                column_name=column_name,
                                data_type=data_type,
                                description=description,
                                is_primary_key=is_primary,
                                is_foreign_key=is_foreign,
                                github_path=github_path
                            )
                            logger.debug(f"Created column: {column_name}")
                    except Exception as e:
                        logger.warning(f"Error creating column: {str(e)}")
            
            # Process column relationships
            if "column_relationships" in column_lineage:
                for rel in column_lineage["column_relationships"]:
                    try:
                        source_table_name = rel.get("source_table")
                        source_column_name = rel.get("source_column")
                        target_column_name = rel.get("target_column")
                        rel_type = rel.get("relationship_type", "dependency")
                        
                        if not source_column_name or not target_column_name:
                            continue
                        
                        # Find or create source table
                        source_table_id = None
                        if source_table_name:
                            source_table = self.get_table_by_name(source_table_name)
                            if not source_table:
                                # Create source table
                                source_table_id = self.create_or_get_table(
                                    table_name=source_table_name,
                                    tech_stack="unknown",  # Using unknown since we dont have tech stack info
                                    github_path=github_path
                                )
                            else:
                                source_table_id = source_table["table_id"]
                        
                            if source_table_id:
                                # Create or get source column
                                source_column_id = self.create_or_get_column(
                                    table_id=source_table_id,
                                    column_name=source_column_name,
                                    github_path=github_path
                                )
                                
                                # Create or get target column
                                target_column_id = self.create_or_get_column(
                                    table_id=table_id,
                                    column_name=target_column_name,
                                    github_path=github_path
                                )
                                
                                # Create relationship
                                self.create_or_get_relationship(
                                    source_table_id=source_table_id,
                                    target_table_id=table_id,
                                    relationship_type=rel_type,
                                    source_column_id=source_column_id,
                                    target_column_id=target_column_id,
                                    github_path=github_path
                                )
                                logger.debug(f"Created column relationship: {source_column_name} -> {target_column_name}")
                    except Exception as e:
                        logger.warning(f"Error creating column relationship: {str(e)}")
            
            # Store the lineage definition for visualization
            lineage_json = {
                "tables": [{"id": table_id, "name": table_lineage.get("target_table")}],
                "source_tables": source_tables,
                "columns": column_lineage.get("target_columns", []),
                "relationships": column_lineage.get("column_relationships", [])
            }
            
            lineage_id = str(uuid.uuid4())
            
            # Store the lineage definition
            cursor.execute(
                """INSERT INTO lineage_definitions 
                   (lineage_id, root_table_id, lineage_json, tech_stack, github_path, created_at, updated_at) 
                   VALUES (?, ?, ?, ?, ?, datetime("now"), datetime("now"))""",
                (lineage_id, table_id, json.dumps(lineage_json), "unknown", github_path)
            )
            
            conn.commit()
            logger.info(f"Stored lineage definition with ID {lineage_id}")
            
            return lineage_id
        except Exception as e:
            logger.error(f"Error storing lineage: {str(e)}")
            conn.rollback()
            raise
        finally:
            conn.close()
